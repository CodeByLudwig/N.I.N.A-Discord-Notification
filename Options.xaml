<ResourceDictionary
    x:Class="NINA.DiscordNotification.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rules="clr-namespace:NINA.Core.Utility.ValidationRules;assembly=NINA.Core"
    >
    <!--  This data template will be displayed in N.I.N.A. on the options->plugin tab with the datacontext of the TestPlugin instance  -->
    <!--  In order for this datatemplate to be picked correctly, the key has to follow the naming convention of <IPlugin.Name>_Options -->
    <!--  Furthermore the Resource Dictionary has to be exported via code behind export attributes  -->
    <DataTemplate x:Key="Discord Notification_Options">
        <StackPanel Orientation="Vertical">
            <Expander
                Margin="0,10,0,10"
                ExpandDirection="Down"
                IsExpanded="true">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0,0,5"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="General" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0" Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Width="200" ToolTip="Not used for threads" VerticalAlignment="Center" Text="Discord Webhook URL" />
                        <TextBox Margin="10,0,0,0" Grid.Column="1" Text="{Binding DiscordWebhookUrl}" />
                        <Button
                                 Height="20"
                                 Width="130"
                                 Grid.Column="2"
                                 Margin="20,0,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Content="Test Webhook"
                                 Click="TestDiscordWebhook">
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,10,0,0" Width="200" Text="Image Scale Factor (%)" />
                        <TextBox Margin="10,10,0,0" MinWidth="150" Text="{Binding ImageScaleFactor}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Width="200" Text="LiveStacked Image Directory" />
                        <StackPanel
                             Grid.Column="1"
                             Margin="10,0,0,0"
                             Orientation="Horizontal">
                            <TextBox
                             MinWidth="150"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center">
                                <TextBox.Text>
                                    <Binding Path="LiveStackedImageDirectory" UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules>
                                            <rules:DirectoryExistsRule />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <Button
                                 Width="20"
                                 Height="20"
                                 Margin="5,0,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Command="{Binding OpenLiveStackedImageDirectoryDialogCommand}">
                                <Path
                                 Margin="2,10,2,0"
                                 Data="{StaticResource DotsSVG}"
                                 Fill="{StaticResource ButtonForegroundBrush}"
                                 Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Margin="0,5,0,0" Width="200" TextWrapping="Wrap" Text="Send Embeds?" />
                        <CheckBox
                                Margin="10,0,0,0" MinWidth="40"
                                IsChecked="{Binding SendEmbeds}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,10,0,0" Width="200" TextWrapping="Wrap" ToolTip="e.g. R, G, B"  Text="Custom filters for the dropdown list (comma-separated)" />
                        <TextBox Margin="10,10,0,0" MinWidth="150" Text="{Binding CustomFilters}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander 
                Margin="0,10,0,10"
                ExpandDirection="Down"
                IsExpanded="true">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                           FontSize="14"
                           Margin="5,0,0,5"
                           FontWeight="Bold"
                           Text="Thread Options"
                           ToolTip="Manage thread options (only needed when using threads)" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0" Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Width="200" Text="Discord Bot Token" />
                        <TextBox Grid.Column="1" Margin="10,0,0,0" MinWidth="400" Text="{Binding DiscordBotToken}" />
                        <Button
                          Grid.Column="2"
                          Height="20"
                          Width="130"
                          Margin="20,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Content="Test Token"
                          Click="TestDiscordToken">
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,10,0,0" Width="200" Text="Discord Channel Id" />
                        <TextBox Margin="10,10,0,0" MinWidth="150" Text="{Binding DiscordChannelId}" />
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,10,0" Width="200" Text="Thread name template" />
                        <TextBox 
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            MinWidth="150"
                            Text="{Binding ThreadNameTemplate}" />
                        <TextBox
                            Text="Placeholders: $$TARGET$$, $$DATE$$, $$DATEMINUS12$$, $$DATETIME$$, $$TIME$$, $$FILTER$$"
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            Grid.Column="2"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Cursor="IBeam" />
                    </Grid>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Width="200" Text="Thread Archive Duration" />
                        <ComboBox
                        Margin="10,0,0,0"
                        MinWidth="150"
                        DisplayMemberPath="Value"
                        ItemsSource="{Binding ArchiveDurations}"
                        SelectedValue="{Binding ArchiveDuration}"
                        SelectedValuePath="Key" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>