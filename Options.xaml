<ResourceDictionary
    x:Class="DanielLudwig.NINA.DiscordNotification.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  This data template will be displayed in N.I.N.A. on the options->plugin tab with the datacontext of the TestPlugin instance  -->
    <!--  In order for this datatemplate to be picked correctly, the key has to follow the naming convention of <IPlugin.Name>_Options -->
    <!--  Furthermore the Resource Dictionary has to be exported via code behind export attributes  -->
    <DataTemplate x:Key="Discord Notification_Options">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="120" Text="Discord Webhook URL" />
                <TextBox Margin="10,0,0,0" MinWidth="250" Text="{Binding DiscordWebhookUrl}" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <TextBlock Width="120" Text="Image Directory" />
                <TextBox Margin="10,0,0,0" MinWidth="250" Text="{Binding ImageDirectory}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>